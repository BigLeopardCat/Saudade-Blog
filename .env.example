# Copy to .env; keep private. Runtime variables stay on the server.
# Full setup: docs/deployment-and-ops.md; frontend build settings: frontend/vite.config.ts.
# Use postgres:// for DATABASE_URL and independent random signing keys (at least 32 random bytes each).
# SITE_URL and build-time VITE_SITE_URL identify your own deployment.
# Optional services may remain unconfigured. Paid image generation needs human approval.

DATABASE_URL=postgres://saudade_app:改成你的密码@127.0.0.1:5432/saudade_blog
JWT_SECRET=请换成一串随机字符
# Never copy login or delegation signing keys into the Agent environment.
BLOG_DELEGATION_SECRET=
AGENT_ASSERTION_SECRET=
# Only needed with IOT_ENABLED=1; shared with device-service, never Agent.
DEVICE_SIGNING_SECRET=
SITE_URL=https://example.com
# VITE_SITE_AUTHOR=你的名字
AGENT_URL=http://127.0.0.1:8010/chat
# AI_REVIEW_URL=http://127.0.0.1:8010/review
# GRAPH_SERVICE_URL=http://127.0.0.1:8010
# CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:5173
# UPLOAD_DIR=/var/lib/saudade/uploads
# CHAT_QUOTA_LIMIT=500
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECS=300
# LOGIN_LOCKOUT_SECS=900
# SAUDADE_MONITOR_LOG=logs/frontend/monitor.log
# CHAT_DEBUG_BODY=1
# GRAPH_ARTIFACT_DIR=/var/lib/saudade/article-graph
# IOT_ENABLED=1
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=你的桶名
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# 仅生图服务请求使用；留空直连，不影响 Agent、图库、数据库等连接。
OPENAI_IMAGE_PROXY_URL=
OPENAI_IMAGE_MODELS=gpt-image-2.5-sunburst,gpt-image-2.5-flare,gpt-image-2
