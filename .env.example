# ═══════════════════════════════════════════════════════════════════════
# Saudade Blog —— 环境变量模板
#
#   cp .env.example .env   # 然后按下面的注释改
#
# `.env` 与它的任何变体（`.env.production` 等）都在 `.gitignore` 里，
# **只有本文件进库**。加新变量时请同时更新这里 —— 这份文件是别人
# 唯一能知道"这个项目要配什么"的地方。
#
# 格式说明：本文件由应用启动时用 `dotenvy` 读取（`src/main.rs`），
# 也由 `scripts/deploy/*` 用 `export $(grep -v '^#' .env | xargs)` 读。
# ⇒ **值里不要有空格，也不要加引号**（那种写法在 shell 那条路径上会散架）。
# ═══════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────
# 必填：不配就起不来
# ───────────────────────────────────────────────────────────────────────

# MySQL 连接串。`src/main.rs` 缺了它直接 panic（"DATABASE_URL must be set"）。
# 库和应用账号都要先建好（CREATE USER + GRANT，见 CONTRIBUTING.md §2.1），
# 再把 scripts/migration/ 下的建表脚本按顺序跑一遍。
# 用户名代码里没写死，换成你自己的也行；库名必须是 saudade_blog。
DATABASE_URL=mysql://saudade_blog:改成你的密码@127.0.0.1:3306/saudade_blog

# JWT 签名密钥（HS256）。登录令牌、给 agent 的短期断言令牌都用它签。
# 缺了会在登录时 panic。**线上务必换成随机长串**，别用示例值：
#   openssl rand -hex 32
# 换掉它 = 所有已发出的令牌立即失效（所有人需重新登录）。
# ⚠️ 改了它之后，MySQL 里已有的旧令牌不会自动清理，只是验不过 —— 这是预期的。
JWT_SECRET=请换成一串随机字符


# ───────────────────────────────────────────────────────────────────────
# 站点身份：别人部署**只需要改这一个**
# ───────────────────────────────────────────────────────────────────────

# 本站地址，形如 https://example.com，**不要带尾斜杠**。
# 三处消费：sitemap.xml 的 <loc> 前缀、CORS 默认白名单、前端 canonical/og:url。
# 不设会回落到 http://localhost:3000（中性占位，爬虫会忽略）——所以**你的部署必须设它**。
# 前端那一半是构建期变量，要在构建环境里设 VITE_SITE_URL（见 frontend/vite.config.ts）。
SITE_URL=https://example.com

# 站点署名。前端构建期用，对应 <meta name="author">。**不设 = 不留署名**（那一行会被
# 整条删掉），代码里没有预设任何人的名字。
# VITE_SITE_AUTHOR=你的名字


# ───────────────────────────────────────────────────────────────────────
# Agent（看板娘）对接
# ───────────────────────────────────────────────────────────────────────

# Python agent 的对话接口。agent 独立成仓（BigLeopardCat/saudade-blog-agent），
# 默认跑在 127.0.0.1:8010，所以多数情况下**不用配**。
# 注意值里要带 /chat 后缀：本仓会按它派生出 /review（说说审核）那个端点。
AGENT_URL=http://127.0.0.1:8010/chat


# ───────────────────────────────────────────────────────────────────────
# 可选：都有合理默认值，不配就是下面这些
# ───────────────────────────────────────────────────────────────────────

# 跨域白名单，逗号分隔。不配则只允许 SITE_URL 一个来源。
# 本地用 Vite 热更新调前端时把它放开（Vite 默认 5173 端口）。
# CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:5173

# 上传文件的落地目录，相对仓库根。不配 = ./uploads。
# UPLOAD_DIR=uploads

# 每个会话最多保留多少条聊天历史（超出按会话删最旧的）。
# CHAT_HISTORY_LIMIT=500

# 每个用户的终身对话轮数上限。**非正数一律回落成默认值**（写坏了不让全站哑掉）。
# CHAT_QUOTA_LIMIT=500

# 登录限流：窗口内允许几次失败 / 窗口秒数 / 触发后锁多久。
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECS=300
# LOGIN_LOCKOUT_SECS=900

# 前端错误上报的落盘路径（浏览器 JS 异常 POST /api/monitor/log 写到这）。
# 不配 = logs/frontend/monitor.log。
# SAUDADE_MONITOR_LOG=logs/frontend/monitor.log

# 调试用：设了它就把每次对话的原始请求体 eprintln 到日志。**线上别开**（会打用户内容）。
# CHAT_DEBUG_BODY=1

# 首页「文章向量空间」产物的目录（`.js` + manifest.json）。默认指向 agent 仓的
# saudade-blog-agent/data/word_graph/web —— 后台「站点设置 → 向量图谱」重建出来的
# 产物就写在那儿，路由是 GET /api/public/graph/{manifest,artifact/:file}。
# **只有换机器/换布局（agent 仓不在默认位置）时才需要改**；从没重建过的站点读不到
# manifest，前端会自动回落到仓库里 committed 的那份种子，不配也能用。
# GRAPH_ARTIFACT_DIR=/home/ubuntu/Saudade-Blog/saudade-blog-agent/data/word_graph/web


# ───────────────────────────────────────────────────────────────────────
# 可选件：物联网平台（默认**关**）
# ───────────────────────────────────────────────────────────────────────

# EMQX + device-service + 设备控制台是一整套**可选**能力，源码收在 `iot/`，
# 装不装由部署者定；不装不影响站点与对话 agent 的其它任何部分。
#
# **不设这个变量 = 没装**（不要写 =0，省得两种情况还要分辨）。设成 1/true/yes/on 才算开。
#
# 它不是"一个开关控制一切"，而是**三处消费面各读各的配置、值必须同源**：
#   1. 本文件（Rust 读）      → sitemap.xml 列不列 /device-console/（src/utils.rs::iot_enabled）
#   2. agent 仓 .env（agent 读）→ 对话里被问到时说真话还是说"本站未部署"（config/settings.py）
#   3. nginx 那个 snippet 在不在 → 三个入口存不存在（iot/toggle.sh 增删）
# 三处不一致的典型表现：agent 高高兴兴带你跳一个 404。装完跑一次 `iot/status.sh`
# 它会逐条对比三处、不一致就报出来。安装步骤见 iot/README.md。
#
# IOT_ENABLED=1


# ───────────────────────────────────────────────────────────────────────
# 只在部署时需要（本机跑开发环境不用管）
# ───────────────────────────────────────────────────────────────────────

# Cloudflare R2：CI 构建产物传到那里，服务器再从那里拉。四个都要配齐。
# 桶的布局由 scripts/deploy/upload_to_r2.py 决定（deploy/<完整提交号>/deploy.tar.gz
# + latest.txt），清理策略见 scripts/deploy/prune_r2.py。
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=你的桶名
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...
