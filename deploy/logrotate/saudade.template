# Render __APP_DIR__ and <你的用户名> before installing in /etc/logrotate.d/saudade.
# Persistent service logs use copytruncate; request trace files have separate retention.
__APP_DIR__/logs/*.log
__APP_DIR__/logs/agent/*.log
__APP_DIR__/logs/frontend/*.log {
    daily
    maxsize 20M
    maxage 14
    rotate 14
    compress
    missingok
    notifempty
    copytruncate
    create 0600 <你的用户名> <你的用户名>
    su <你的用户名> <你的用户名>
}
