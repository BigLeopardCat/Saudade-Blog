# Unsupported container draft; see deploy/README.md before use.
# Keep dependency-cache invalidation, binary validation, certificates and timezone data.
FROM rust:1.92-slim AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev cmake findutils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./

RUN mkdir -p src \
 && printf '\n' > src/lib.rs \
 && printf 'fn main() {}\n' > src/main.rs \
 && cargo build --release --locked

COPY src ./src

RUN find src -type f -exec touch {} +

RUN cargo build --release --locked \
 && size="$(stat -c %s target/release/saudade_blog_bin)" \
 && if [ "$size" -lt 4194304 ] || ! grep -aq 'DATABASE_URL' target/release/saudade_blog_bin; then \
        printf '\n✗ 编出来的 target/release/saudade_blog_bin 只有 %s 字节、里面没有 DATABASE_URL。\n  未生成有效的后端二进制，请检查源码复制与构建缓存。\n  先看那条 find…touch 还在不在。\n' "$size" >&2; \
        exit 1; \
    fi \
 && cp target/release/saudade_blog_bin /usr/local/bin/saudade_blog_bin

RUN strip /usr/local/bin/saudade_blog_bin || true


FROM debian:bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai

WORKDIR /srv
RUN mkdir -p /srv/logs/frontend

COPY --from=build /usr/local/bin/saudade_blog_bin /usr/local/bin/saudade_blog_bin

ENTRYPOINT ["/usr/local/bin/saudade_blog_bin"]
