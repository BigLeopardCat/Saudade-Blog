FROM rust:1.92-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY LICENSE THIRD-PARTY.md /licenses/
ENV CARGO_BUILD_JOBS=1
RUN cargo build --release --locked --bins

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 saudade && useradd --uid 10001 --gid 10001 --no-create-home saudade \
    && mkdir -p /srv/logs/frontend /var/lib/saudade/uploads \
    && chown -R 10001:10001 /srv /var/lib/saudade
WORKDIR /srv
COPY --from=build /build/target/release/saudade_blog_bin /usr/local/bin/
COPY --from=build /build/target/release/saudade-bootstrap-admin /usr/local/bin/
COPY --from=build /licenses /usr/share/doc/saudade
ARG REVISION
LABEL org.opencontainers.image.source=https://github.com/BigLeopardCat/Saudade-Blog \
      org.opencontainers.image.revision=$REVISION
ENV TZ=Asia/Shanghai BLOG_BIND_ADDRESS=0.0.0.0 BLOG_PORT=3000
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=4s --start-period=20s \
    CMD curl --noproxy '*' --fail --max-time 2 --silent http://127.0.0.1:3000/api/health/ready >/dev/null
ENTRYPOINT ["/usr/local/bin/saudade_blog_bin"]
