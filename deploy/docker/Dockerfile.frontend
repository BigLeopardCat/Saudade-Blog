FROM node:24.22.1-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json frontend/widget.lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
COPY LICENSE THIRD-PARTY.md /licenses/
ARG VITE_SITE_URL
ARG NODE_HEAP=1536
ARG REVISION
ENV NODE_OPTIONS=--max-old-space-size=${NODE_HEAP} VITE_SITE_URL=$VITE_SITE_URL
RUN npm run fetch:widget && npm run vendor:live2d && npm run build \
    && test -f dist/live2d-widgets/chat-stream.js \
    && test -f dist/live2d_model/agent_2.model3.json
RUN node -e 'if (!/^[0-9a-f]{40}$/.test(process.env.REVISION || "")) process.exit(1); require("fs").writeFileSync("dist/build-info.json", JSON.stringify({sha: process.env.REVISION, built_at: new Date().toISOString()}))' \
    && git init --quiet /tmp/widget-license \
    && git -C /tmp/widget-license fetch --depth=1 https://github.com/BigLeopardCat/saudade-blog-agent.git "$(node -p 'JSON.parse(require("fs").readFileSync("widget.lock.json")).sha')" \
    && git -C /tmp/widget-license show FETCH_HEAD:frontend/ASSETS-LICENSE.md > /licenses/ASSETS-LICENSE.md \
    && git -C /tmp/widget-license show FETCH_HEAD:LICENSE > /licenses/Agent-LICENSE

FROM nginx:stable-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/docker/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/nginx/snippets/blog-headers /etc/nginx/snippets/blog-headers
COPY --from=build /app/frontend/dist /srv/frontend/dist
COPY --from=build /licenses /usr/share/doc/saudade
ARG REVISION
LABEL org.opencontainers.image.source=https://github.com/BigLeopardCat/Saudade-Blog \
      org.opencontainers.image.revision=$REVISION
EXPOSE 8080 8443
HEALTHCHECK --interval=10s --timeout=3s \
    CMD wget -q --spider http://127.0.0.1:8080/healthz
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
