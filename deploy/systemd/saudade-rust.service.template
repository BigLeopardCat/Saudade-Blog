# Render __APP_DIR__ and <你的用户名> before installation.
# The application reads .env from WorkingDirectory, including optional RUST_LOG.
[Unit]
Description=Saudade Blog Rust Backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=<你的用户名>
Group=<你的用户名>
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/target/release/saudade_blog_bin
Restart=always
RestartSec=5
TimeoutStopSec=360
StandardOutput=append:__APP_DIR__/logs/rust.log
StandardError=append:__APP_DIR__/logs/rust.log

[Install]
WantedBy=multi-user.target
