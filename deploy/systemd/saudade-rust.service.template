[Unit]
Description=Saudade Blog Rust Backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=saudade-blog
Group=saudade-blog
EnvironmentFile=/etc/saudade/blog-runtime.env
WorkingDirectory=/var/lib/saudade-blog
ExecStart=/srv/saudade-blog/saudade_blog_bin
BindReadOnlyPaths=__APP_DIR__/target/release/saudade_blog_bin:/srv/saudade-blog/saudade_blog_bin
BindReadOnlyPaths=-/var/lib/saudade-agent/data/word_graph/web:/var/lib/saudade-blog/article-graph
StateDirectory=saudade-blog
StateDirectoryMode=0750
ReadWritePaths=/var/lib/saudade-blog/uploads
InaccessiblePaths=-/etc/saudade/agent-runtime.env
Restart=always
RestartSec=5
TimeoutStopSec=360
StandardOutput=append:__APP_DIR__/logs/rust.log
StandardError=append:__APP_DIR__/logs/rust.log

[Install]
WantedBy=multi-user.target
