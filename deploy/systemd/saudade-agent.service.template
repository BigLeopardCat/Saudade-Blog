# Render __APP_DIR__ and <你的用户名> before installation.
# Application settings come from the Agent's .env; Uvicorn flags configure the server.
[Unit]
Description=Saudade Blog Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<你的用户名>
Group=<你的用户名>
WorkingDirectory=__APP_DIR__/saudade-blog-agent
ExecStart=/usr/bin/env PYTHONFAULTHANDLER=1 PYTHONUNBUFFERED=1 __APP_DIR__/saudade-blog-agent/.venv/bin/python -m uvicorn agent.main:app --host 127.0.0.1 --port 8010 --workers 1 --timeout-worker-healthcheck 30 --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=120
StandardOutput=append:__APP_DIR__/logs/agent/agent.log
StandardError=append:__APP_DIR__/logs/agent/agent.log

[Install]
WantedBy=multi-user.target
