[Unit]
Description=__DESCRIPTION__
After=network-online.target
Wants=network-online.target

[Service]
Type=__TYPE__
User=saudade-agent
Group=saudade-agent
EnvironmentFile=/etc/saudade/agent-runtime.env
Environment=SAUDADE_IGNORE_ENV_FILE=1
Environment=HOME=/var/lib/saudade-agent
Environment=XDG_CACHE_HOME=/var/cache/saudade-agent
Environment=UV_CACHE_DIR=/var/cache/saudade-agent/uv
Environment=UV_PYTHON_INSTALL_DIR=/var/cache/saudade-agent/python
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONFAULTHANDLER=1
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=__RELEASE_ROOT__/current
ExecStart=__COMMAND__
Restart=__RESTART__
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
StateDirectory=saudade-agent
StateDirectoryMode=0750
CacheDirectory=saudade-agent
CacheDirectoryMode=0750
ReadWritePaths=/var/lib/saudade-agent /var/cache/saudade-agent
BindReadOnlyPaths=-__APP_DIR__/logs/health.log:/run/saudade-host/logs/health.log
BindReadOnlyPaths=-__APP_DIR__/logs/rust.log:/run/saudade-host/logs/rust.log
InaccessiblePaths=-/etc/saudade/blog-runtime.env -/etc/saudade/embedding-api-key
StandardOutput=append:__APP_DIR__/logs/agent/agent.log
StandardError=append:__APP_DIR__/logs/agent/agent.log

[Install]
WantedBy=multi-user.target
