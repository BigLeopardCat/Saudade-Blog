
[Unit]
Description=Saudade IoT device service (device registry / config push / telemetry)
After=network.target emqx.service
Wants=emqx.service

[Service]
Type=simple
User=<跑服务的系统用户，本机是 ubuntu>
WorkingDirectory=<device-service 源码或部署目录的绝对路径>
EnvironmentFile=<上面那个目录>/svc.env
ExecStart=<上面那个目录>/target/release/device-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
